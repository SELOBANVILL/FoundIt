<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are disabled (allowBackup=false). Excluded explicitly as defense in depth:
     the encrypted session file must never leave the device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
